# Select one provider: ollama, groq, openrouter, or openai.
ATLAS_MODEL_PROVIDER=ollama

# Recommended private, local bootstrap provider.
ATLAS_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_OUTPUT_TOKENS=600

# Optional hosted provider.
# ATLAS_MODEL_PROVIDER=groq
# GROQ_API_KEY=
# ATLAS_MODEL=openai/gpt-oss-20b

# Keep 127.0.0.1 for computer-only access. Use 0.0.0.0 to allow trusted
# devices on the same local network to open ATLAS.
ATLAS_HOST=127.0.0.1

# Alternative free-model router.
# OPENROUTER_API_KEY=
# ATLAS_MODEL=openrouter/free

# Original provider.
# OPENAI_API_KEY=
# ATLAS_MODEL=gpt-5.6-sol
